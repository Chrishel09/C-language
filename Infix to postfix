#include<stdio.h>
#include<ctype.h>
#define size 100
char s[size];
int top = -1;
void push(char elem){
    s[++top] = elem;
}
char pop(){
    return (s[top--]);
}
int pr(char elem){
    switch(elem){
        case '#' : return 0;
        case '(' :return 1;
        case '+' : case '-' : return 2;
        case '*' : case '/': case '%' : return 3;
        case '^' : return 4;
    }
}
void main(){
    char ifix[100], pfix[100], ch , elem;
    int i =0, k=0;
    printf("read the i expression \n");
    scanf("%s", ifix);
    push('#');
    while((ch = ifix[i++]) != '\0'){
        if(ch == '('){
            push(ch);
        }
        else if(isalnum(ch)){
            pfix[k++] = ch;
        }
        else if(ch == ')'){
        while(s[top] != '('){
            pfix[k++] = pop();
        }
        elem = pop();
        }
        else {
            while(pr(s[top]) >= pr(ch)){
                pfix[k++]=pop();
            }
            push(ch);
        }
        }
        while(s[top]!= '#'){
            pfix[k++] = pop();
        }
        pfix[k] = '\0';
        printf("given infix expression is : %s \n postfix expression is : %s", ifix, pfix);
    }

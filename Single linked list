    }
    }
    void delete_end(){
        struct node *temp, *ptr;
        if(head == NULL){
            printf("list is empty \n");
            exit(0);
        }
    
        else if(head->link ==NULL){
                ptr = head;
                head = NULL;
                free(ptr);
            }
            else{
                ptr = head;
                while(ptr->link != NULL){
                    temp = ptr;
                    ptr=ptr->link;
                }
                temp->link = NULL;
                free(ptr);
            }

        }

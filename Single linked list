#include<stdio.h>
#include<stdlib.h>
struct node{
    char USN[10],name[20], branch[10];
    long int Phn;
    int sem;
    struct node *link;
};
struct node *head = NULL;
void create(){
    struct node *temp;
    temp = (struct node*)malloc(sizeof(struct node));
    if(temp == NULL){
        printf("out of memory");
        exit(0);
    }
    printf("enter details:\n");
    printf("Enter name:");
    scanf("%s",temp -> name);
    printf("Enter USN:");
    scanf("%s",temp -> USN); 
    printf("Enter branch:");
    scanf("%s",&temp -> branch);
    printf("Enter phone number:");
    scanf("%ld",&temp -> Phn);
    printf("Enter sem:");
    scanf("%d",&temp -> sem);
    temp->link = NULL;
    if(head == NULL){
        head = temp;
    }
    else{
        temp->link=head;
        head = temp;
    }
    }
